<Page x:Class="Sheina41.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Sheina41"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage" FontFamily="Comic Sans MS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <WrapPanel>
            <StackPanel Orientation="Vertical" Margin="10" VerticalAlignment="Top">
                <TextBlock Text="Вы авторизованы как " FontSize="20"></TextBlock>
                <TextBlock Text="Роль: " FontSize="20"></TextBlock>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10" Grid.ColumnSpan="2" VerticalAlignment="Top">
                <TextBlock Name="FIOTB" FontSize="20"></TextBlock>
                <TextBlock Name="RoleTB" FontSize="20"></TextBlock>
            </StackPanel>
        </WrapPanel>

        <StackPanel Orientation="Horizontal" Margin="5" Grid.Column="0" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center">
            <TextBlock Name="TBCount" FontSize="20" VerticalAlignment="Top" Margin="5" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Vertical" Margin="10" Grid.Row="1">
                <TextBlock Text="поиск по наименованию" Width="300" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
                <TextBox Name="TBoxSearch" TextChanged="TBoxSearch_TextChanged" Width="200" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"></TextBox>
            </StackPanel>
        </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10" HorizontalAlignment="Center" Grid.Column="2" Grid.Row="1">
            <TextBlock Text="выберете скидку для поиска" TextAlignment="Right" Width="300" FontSize="20" Grid.Column="2"></TextBlock>
            <ComboBox Name="ComboType" SelectionChanged="ComboType_SelectionChanged" FontSize="15" Width="200" Grid.Column="2">
                <TextBlock>Все диапазоны</TextBlock>
                <TextBlock>от 0 до 9,99</TextBlock>
                <TextBlock>от 10 до 14,99</TextBlock>
                <TextBlock>от 15 и больше</TextBlock>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="5" HorizontalAlignment="Center" Grid.Column="1">
            <RadioButton Content="По возрастанию стоимости" GroupName="Sort"
                         Width="300" FontSize="20" Checked="RadioButton_Checked" Name="RButtonUp"></RadioButton>
            <RadioButton Content="По убыванию стоимости" GroupName="Sort" Name="RButtonDown" Width="300" FontSize="20" Checked="RButtonDown_Checked"></RadioButton>
        </StackPanel>
        <ListView Name="ServiceListView" Grid.Row="3" Grid.ColumnSpan="3">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                            <ColumnDefinition Width="600"></ColumnDefinition>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                            <ColumnDefinition Width="500"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Width="200" Grid.Column="0" Grid.RowSpan="4" Stretch="UniformToFill" HorizontalAlignment="Center">
                            <Image.Source>
                                <Binding Path="ProductPhotoSt">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            /Photo/picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <TextBlock Text="{Binding ProductName}" FontWeight="Black" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" FontSize="25"></TextBlock>
                        <TextBlock Text="{Binding ProductStatus}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" FontSize="20"></TextBlock>
                        <TextBlock Text="{Binding Manufactur}" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" FontSize="20"></TextBlock>
                        <TextBlock Text="{Binding ProductCost}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left" FontSize="20"></TextBlock>
                        <TextBlock Text="Скидка" Grid.Column="3" Grid.Row="0" HorizontalAlignment="Right" FontSize="20"/>
                        <TextBlock Text="{Binding ProductDiscountAmount, StringFormat={}{0} %}" Grid.Column="3" Grid.Row="1" Grid.RowSpan="2" FontSize="50" HorizontalAlignment="Right"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
