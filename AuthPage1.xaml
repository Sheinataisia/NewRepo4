<Page x:Class="Sheina41.AuthPage1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Sheina41"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage1" FontFamily="Comic Sans MS">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Логин" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" Margin="10"></TextBlock>
        <TextBlock Text="Пароль" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" Margin="10"></TextBlock>
        <TextBox Name="TBoxLogin" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Height="30" Width="200" TextChanged="TBoxLogin_TextChanged"  FontSize="20"></TextBox>
        <TextBox Name="TBoxPassword" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Height="30" Width="200" TextChanged="TBoxPassword_TextChanged" FontSize="20"></TextBox>
        <Button Name="LoginBtn" Content="Войти" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Center" Click="LoginBtn_Click"></Button>
        <Button Name="VxodBtn" Content="Войти как гость" Grid.Column="0" Grid.Row="2" HorizontalAlignment="Center" Click="VxodBtn_Click"></Button>
        <StackPanel Name="CapchaPanel" Orientation="Horizontal" Grid.Row="2" Grid.Column="0" Height="40" Width="200" VerticalAlignment="Top" HorizontalAlignment="Center" Visibility="Hidden">
            <TextBlock Name="capthaOneWord" FontSize="22" Margin="30,0,0,0" Width="20"></TextBlock>
            <TextBlock Name="capthaOTwoWord" FontSize="22" TextDecorations="Strikethrough" Margin="0,5,0,0" Width="20"></TextBlock>
            <TextBlock Name="capthaThreeWord" FontSize="22" TextDecorations="Strikethrough" Width="20"></TextBlock>
            <TextBlock Name="capthaFourWord" FontSize="22" TextDecorations="Strikethrough" Margin="0,10,0,0" Width="20"></TextBlock>
        </StackPanel>
        <TextBox Name="TBoxCaptcha" Width="150" Margin="5" Grid.Column="0" Grid.Row="3" Height="30" VerticalAlignment="Top" HorizontalAlignment="Right" Visibility="Hidden" FontSize="20"></TextBox>
        <Button Name="TButtonGo" Content="Ввести" Grid.Column="1" Grid.Row="3" VerticalAlignment="Top" HorizontalAlignment="Left" Click="TButtonGo_Click" Visibility="Hidden"></Button>
    </Grid>
</Page>
